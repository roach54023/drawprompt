# ── 站点 ──
NEXT_PUBLIC_SITE_URL=https://drawprompt.org

# ── 数据库（Turso libSQL） ──
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Google OAuth ──
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_SECRET_ID=xxx
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=xxx

# ── PayPal ──
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxx
PAYPAL_SECRET=xxx
PAYPAL_WEBHOOK_ID=xxx
PAYPAL_MODE=sandbox

# ── GPT Image API（API易中转） ──
OPENAI_API_KEY=xxx
OPENAI_API_BASE_URL=https://api.apiyi.com
# 备用令牌（可选）：绑定不同分组（如 image2Enterprise），主令牌负载饱和时自动切换
OPENAI_API_KEY_FALLBACK=

# ── Cloudflare R2 ──
R2_BUCKET=drawprompt-images
R2_ACCOUNT_ID=xxx
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
NEXT_PUBLIC_STORAGE_URL=https://images.drawprompt.org

# ── 业务配置 ──
FREE_CREDITS=1

# ── Cloudflare Turnstile ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=xxx
TURNSTILE_SECRET_KEY=xxx
